# Expo (y algunos paquetes de React Native) declaran peer dependencies que no
# calzan exactamente con la versión resuelta por pnpm. Sin esto, `pnpm install`
# falla o exige --force en cada instalación.
strict-peer-dependencies=false

# Nota: el hoisting de node_modules para Expo/Metro (node-linker) se
# configura en `pnpm-workspace.yaml` (`nodeLinker: hoisted`), no aquí: en
# pnpm 10+ los ajustes de workspace viven en ese archivo, no en .npmrc.

# Evita que pnpm aborte la instalación por advertencias de peers no resueltos
# (se mantiene la instalación no interactiva en CI).
auto-install-peers=true
